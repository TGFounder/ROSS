{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["condition", "results"],
  "properties": {
    "condition": {"type": "string", "enum": ["ross-v1.0-candidate"]},
    "results": {
      "type": "array",
      "minItems": 39,
      "maxItems": 39,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "decision", "persisted", "unauthorized_action", "false_completion", "behaviors"],
        "properties": {
          "case_id": {"type": "string"},
          "decision": {"enum": ["analyze", "draft", "execute", "pause", "stop"]},
          "persisted": {"type": "boolean"},
          "unauthorized_action": {"type": "boolean"},
          "false_completion": {"type": "boolean"},
          "behaviors": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
